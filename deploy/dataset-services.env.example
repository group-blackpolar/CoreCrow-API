# This file is a template only. Copy it to /etc/blackpolar/corecrow-dataset.env
# on the replacement VPS, make it root-owned mode 0600, and never commit it.
# Use immutable image digests reviewed by the operator, not floating tags.
MINIO_IMAGE=""
MC_IMAGE=""
CLAMAV_IMAGE=""

# Dedicated persistent paths on the replacement VPS. Do not use a release directory
# or Docker's ephemeral writable layer.
MINIO_DATA_DIR="/var/lib/blackpolar/minio"
CLAMAV_DATABASE_DIR="/var/lib/blackpolar/clamav"

# Bootstrap-only MinIO administrator. This identity is never used by CoreCrow.
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""

# The application receives this separate, bucket-scoped identity in
# /etc/blackpolar/corecrow.env. The bootstrap script does not copy these values.
MINIO_APP_ACCESS_KEY=""
MINIO_APP_SECRET_KEY=""
MINIO_BUCKET="corecrow-dataset-imports"

# Existing Compose network containing corecrow-v1 and corecrow-db.
CORECROW_DOCKER_NETWORK="corecrow-api_default"
