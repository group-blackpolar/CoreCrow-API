// ---------------------------------------------------------------------------
// Documents: tenant-scoped, workflow-driven records (forms, quotes, work orders).
// A DocumentType is configuration; a Document is an instance. Audit history lives
// in AuditLog (targetType "Document"); nothing here duplicates it.
// ---------------------------------------------------------------------------

enum DocumentStatus {
  DRAFT
  READY
  SENT
  COMPLETED
  CANCELLED
}

enum DocumentTypeStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentAttachmentStorage {
  DATABASE
}

model DocumentType {
  id              String             @id @default(cuid())
  organizationId  String
  /// Stable machine key (for example "forma"); never shown to users.
  key             String
  name            Json
  /// Human reference prefix: SEM -> SEM-000001.
  referencePrefix String
  currency        String             @default("USD")
  /// Future: custom statuses, fields and templates. Not interpreted yet.
  config          Json               @default("{}")
  status          DocumentTypeStatus @default(ACTIVE)
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents       Document[]
  sequence        DocumentSequence?

  @@unique([id, organizationId])
  @@unique([organizationId, key])
  @@unique([organizationId, referencePrefix])
}

/// Gap-free per-type counter, incremented inside the creating transaction.
model DocumentSequence {
  typeId         String
  organizationId String
  lastValue      Int          @default(0)
  type           DocumentType @relation(fields: [typeId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([typeId])
  @@unique([typeId, organizationId])
}

model DocumentClient {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  /// Lower-cased email, unique per organization when present.
  emailKey       String?
  phone          String?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents      Document[]

  @@unique([id, organizationId])
  @@unique([organizationId, emailKey])
  @@index([organizationId, name])
}

model Document {
  id              String               @id @default(cuid())
  organizationId  String
  typeId          String
  sequence        Int
  reference       String
  status          DocumentStatus       @default(DRAFT)
  documentDate    DateTime             @default(now())
  clientId        String?
  /// Frozen snapshot: a later client edit never rewrites an issued document.
  clientName      String
  clientEmail     String?
  clientPhone     String?
  comments        String               @default("")
  currency        String
  subtotal        Decimal              @db.Decimal(14, 2)
  discountTotal   Decimal              @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal              @default(0) @db.Decimal(14, 2)
  total           Decimal              @db.Decimal(14, 2)
  /// Future type-specific fields.
  data            Json                 @default("{}")
  version         Int                  @default(1)
  createdBy       String
  updatedBy       String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  statusChangedAt DateTime             @default(now())
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type            DocumentType         @relation(fields: [typeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  client          DocumentClient?      @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: SetNull)
  items           DocumentItem[]
  attachments     DocumentAttachment[]

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@unique([typeId, sequence])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, clientId])
  @@index([organizationId, documentDate])
}

model DocumentItem {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  position       Int
  name           String
  description    String   @default("")
  sku            String?
  unit           String?
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(14, 2)
  total          Decimal  @db.Decimal(14, 2)
  /// Future: tax rate, discount, price list reference.
  meta           Json     @default("{}")
  document       Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([documentId, position])
  @@index([organizationId, documentId])
}

model DocumentAttachment {
  id             String                    @id @default(cuid())
  organizationId String
  documentId     String
  filename       String
  mimeType       String
  size           Int
  sha256         String
  /// Provider seam: DATABASE today; an object-storage provider can be added without changing callers.
  storage        DocumentAttachmentStorage @default(DATABASE)
  createdBy      String
  createdAt      DateTime                  @default(now())
  document       Document                  @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  blob           DocumentAttachmentBlob?

  @@unique([id, organizationId])
  @@index([organizationId, documentId])
}

/// Binary payload kept apart from metadata so list queries never load bytes.
model DocumentAttachmentBlob {
  attachmentId String             @id
  data         Bytes
  attachment   DocumentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

enum AIApplication {
  NORTH
}

enum AIRunStatus {
  QUEUED
  RUNNING
  WAITING_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
}

enum AIMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum AIToolCallStatus {
  PROPOSED
  RUNNING
  COMPLETED
  FAILED
}

enum AIActionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
}

model AIConversation {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  application    AIApplication
  title          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages       AIMessage[]
  runs           AIRun[]
  usage          AIUsage[]

  @@index([organizationId, userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  runId          String?
  role           AIMessageRole
  content        String
  toolName       String?
  toolCallId     String?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  run            AIRun?         @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
  @@index([runId])
}

model AIRun {
  id                      String         @id @default(cuid())
  conversationId          String
  organizationId          String
  userId                  String
  application             AIApplication
  status                  AIRunStatus    @default(QUEUED)
  provider                String
  model                   String
  failureCode             String?
  failureMessage          String?
  cancellationRequestedAt DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  conversation            AIConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages                AIMessage[]
  events                  AIEvent[]
  toolCalls               AIToolCall[]
  actions                 AIAction[]
  usage                   AIUsage[]

  @@index([organizationId, userId, createdAt])
  @@index([status, createdAt])
}

model AIEvent {
  id        String   @id @default(cuid())
  runId     String
  sequence  Int
  type      String
  data      Json
  createdAt DateTime @default(now())
  run       AIRun    @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
}

model AIToolCall {
  id          String           @id @default(cuid())
  runId       String
  providerId  String?
  name        String
  risk        String
  arguments   Json
  result      Json?
  status      AIToolCallStatus @default(PROPOSED)
  errorCode   String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  run         AIRun            @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, createdAt])
}

model AIAction {
  id             String         @id @default(cuid())
  runId          String
  organizationId String
  userId         String
  toolName       String
  arguments      Json
  status         AIActionStatus @default(PENDING_CONFIRMATION)
  expiresAt      DateTime
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  run            AIRun          @relation(fields: [runId], references: [id], onDelete: Restrict)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, status])
}

model AIUsage {
  id                    String         @id @default(cuid())
  runId                 String
  conversationId        String
  organizationId        String
  userId                String
  application           AIApplication
  provider              String
  model                 String
  inputTokens           Int
  outputTokens          Int
  totalTokens           Int
  latencyMs             Int
  estimatedCostMicrousd BigInt
  pricingVersion        String
  createdAt             DateTime       @default(now())
  run                    AIRun          @relation(fields: [runId], references: [id], onDelete: Restrict)
  conversation           AIConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                   User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([runId])
}

/// A named processing script owned by a dataset group. Source lives in immutable versions; nothing here is ever executed in-process.
model NorthPipelineScript {
  id             String                      @id @default(cuid())
  organizationId String
  groupId        String
  slug           String
  name           String
  description    String?
  language       String                      @default("python")
  status         NorthDatasetGroupStatus     @default(ACTIVE)
  createdBy      String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  group          NorthDatasetGroup           @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  versions       NorthPipelineScriptVersion[]

  @@unique([id, organizationId])
  @@unique([groupId, slug])
  @@index([organizationId, groupId, status])
}

model NorthPipelineScriptVersion {
  id             String              @id @default(cuid())
  organizationId String
  scriptId       String
  version        Int
  source         String
  sourceSha256   String
  /// Declared parameters: [{ name, type: string|number|boolean|date, required, default?, description? }].
  params         Json                @default("[]")
  /// Ordered pipeline stages with an enabled flag: [{ id, enabled }].
  steps          Json                @default("[]")
  note           String?
  createdBy      String
  createdAt      DateTime            @default(now())
  script         NorthPipelineScript @relation(fields: [scriptId, organizationId], references: [id, organizationId], onDelete: Restrict)
  runs           NorthPipelineRun[]

  @@unique([scriptId, version])
  @@unique([id, organizationId])
}

/// One execution (or blocked attempt) of a script version: exact version, parameters, outcome and statistics.
model NorthPipelineRun {
  id              String                 @id @default(cuid())
  organizationId  String
  groupId         String
  datasetId       String?
  importId        String?
  scriptVersionId String
  kind            NorthPipelineRunKind
  status          NorthPipelineRunStatus @default(QUEUED)
  params          Json                   @default("{}")
  stats           Json?
  report          Json?
  errorCode       String?
  requestedBy     String
  createdAt       DateTime               @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  group           NorthDatasetGroup      @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scriptVersion   NorthPipelineScriptVersion @relation(fields: [scriptVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, groupId, createdAt])
  @@index([organizationId, datasetId, createdAt])
}

enum SecurityOverflowPolicy {
  BLOCK_NEW
  REPLACE_OLDEST
  REQUIRE_USER_CHOICE
}

enum SecurityIpRuleKind {
  ALLOW
  DENY
}

enum SecurityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SecurityAlertEmailStatus {
  NONE
  SENT
  FAILED
}

/// Security & access policy of one organization. No row = feature off for that organization (nothing tracked or enforced).
model OrganizationSecurityPolicy {
  organizationId       String                 @id
  /// Master switch for the device/session limits. Tracking happens whenever the row exists.
  enforcement          Boolean                @default(false)
  maxDevices           Int?
  maxSessions          Int?
  overflowPolicy       SecurityOverflowPolicy @default(BLOCK_NEW)
  alertsEnabled        Boolean                @default(true)
  alertEmailEnabled    Boolean                @default(false)
  /// Explicit recipients; empty = the organization's owners that have a real mailbox.
  alertEmailRecipients String[]               @default([])
  retentionDays        Int                    @default(90)
  retentionExemptUntil DateTime?
  retentionExemptReason String?
  retentionExemptBy    String?
  updatedAt            DateTime               @updatedAt
  updatedBy            String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_security_policies")
}

model SecurityDevice {
  id             String    @id @default(cuid())
  userId         String
  /// Organization whose policy governed the device when it was registered.
  organizationId String
  /// SHA-256 of the opaque device cookie; the cookie value itself is never stored.
  tokenHash      String    @unique
  userAgent      String?
  firstIp        String?
  lastIp         String?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  revokedBy      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt, lastSeenAt])
  @@index([userId, revokedAt])
  @@map("security_devices")
}

model SecurityIpRule {
  id             String             @id @default(cuid())
  organizationId String
  kind           SecurityIpRuleKind
  /// Normalized `address/prefix` (IPv4, IPv6 or CIDR).
  cidr           String
  note           String?
  createdBy      String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, cidr])
  @@map("security_ip_rules")
}

model SecurityAlert {
  id             String                   @id @default(cuid())
  organizationId String
  kind           String
  severity       String
  userId         String?
  /// Same dedupKey within an organization collapses into one alert whose `count` grows.
  dedupKey       String
  count          Int                      @default(1)
  details        Json?
  status         SecurityAlertStatus      @default(OPEN)
  emailStatus    SecurityAlertEmailStatus @default(NONE)
  emailError     String?
  firstSeenAt    DateTime                 @default(now())
  lastSeenAt     DateTime                 @default(now())
  handledBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupKey])
  @@index([organizationId, status, lastSeenAt])
  @@map("security_alerts")
}

/// Result of each retention sweep per organization (also audited), shown in the Security overview.
model SecurityRetentionRun {
  id             String   @id @default(cuid())
  organizationId String
  ranAt          DateTime @default(now())
  retentionDays  Int
  purgedAlerts   Int      @default(0)
  purgedDevices  Int      @default(0)
  skipped        String?

  @@index([organizationId, ranAt])
  @@map("security_retention_runs")
}
