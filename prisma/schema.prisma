  dataset         NorthDataset              @relation("NorthDatasetRevisions", fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  schemaVersion   NorthDatasetSchemaVersion @relation(fields: [schemaVersionId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)
  creator         User                      @relation("NorthDatasetRevisionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  batches         NorthDatasetRevisionBatch[]
  activeFor       NorthDataset[]            @relation("ActiveDatasetRevision")

  @@unique([id, datasetId, organizationId])
  @@unique([datasetId, version])
  @@index([organizationId, datasetId, createdAt])
}

model NorthDatasetRevisionBatch {
  organizationId String
  datasetId      String
