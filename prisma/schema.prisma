enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

/// A member asks for one registered permission; an administrator approves (optionally time-boxed) or denies it.
model AccessRequest {
  id             String              @id @default(cuid())
  organizationId String
  membershipId   String
  permission     String
  reason         String
  requestedDays  Int?
  status         AccessRequestStatus @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?
  grantExpiresAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  membership     Membership          @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([membershipId, status])
}

model Invitation {
  id               String                      @id @default(cuid())
  organizationId   String
  kind             InvitationKind              @default(EMAIL)
  email            String?
  role             TenantRole                  @default(MEMBER)
  tokenHash        String                      @unique
  /// Last characters of the issued credential, so admins can tell keys apart. Never the credential.
  tokenHint        String?
  /// CODE keys may be redeemed several times; acceptedAt is set once useCount reaches maxUses.
  maxUses          Int                         @default(1)
  useCount         Int                         @default(0)
  createdByUserId  String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  archivedAt       DateTime?
  createdAt        DateTime                    @default(now())
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  groupGrants      InvitationGroupGrant[]
  permissionGrants InvitationPermissionGrant[]

  @@unique([id, organizationId])
  @@index([organizationId, email])
  @@index([organizationId, kind, createdAt])
  @@index([organizationId, archivedAt])
}

