generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  DEVELOPER
  ADMIN
  SUPERADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CLOSED
}

model User {
  id                     String        @id @default(cuid())
  email                  String        @unique
  emailVerified          Boolean       @default(false)
  name                   String?
  image                  String?
  role                   Role          @default(USER)
  status                 AccountStatus @default(ACTIVE)
  adminSecretHash        String?
  /// AES-256-GCM `v1:<iv>:<ciphertext>:<tag>`; only used by SUPERADMIN Reveal, never to authenticate.
  adminSecretCiphertext  String?
  adminSecretEncryptionVersion Int?
  passwordChangeRequired Boolean       @default(false)
  termsAcceptedAt        DateTime?
  termsVersion           String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  sessions                   Session[]
  accounts                   Account[]
  apiKeys                    ApiKey[]
  memberships                Membership[]
  emailVerificationChallenge EmailVerificationChallenge?
  northPlatformGrants        NorthPlatformGrant[]
  northPanelRevisions        NorthPanelRevision[]
  northAssets                NorthAsset[]
  northTemplatesCreated      NorthTemplate[]             @relation("NorthTemplateCreator")
  northTemplateVersionsMade  NorthTemplateVersion[]      @relation("NorthTemplateVersionCreator")
  northDatasetsCreated       NorthDataset[]              @relation("NorthDatasetCreator")
  northDatasetSchemasCreated NorthDatasetSchemaVersion[] @relation("NorthDatasetSchemaCreator")
  northDatasetAclRulesMade   NorthDatasetAcl[]           @relation("NorthDatasetAclCreator")
  northDatasetImports        NorthDatasetImportJob[]     @relation("NorthDatasetImportRequester")
  northDatasetMappingsMade   NorthDatasetImportMappingVersion[] @relation("NorthDatasetImportMappingCreator")
  northDatasetActivations    NorthDatasetImportJob[]     @relation("NorthDatasetActivationRequester")
  northDatasetRevisionsMade NorthDatasetRevision[]       @relation("NorthDatasetRevisionCreator")
  northAnalyticsBindingsMade NorthAnalyticsBinding[]     @relation("NorthAnalyticsBindingCreator")

  @@index([status, createdAt])
  @@map("users")
}

model EmailVerificationChallenge {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_challenges")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verifications")
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String // "user.create", "token.revoke", "logs.view", etc.
  targetType     String?
  targetId       String?
  metadata       Json?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt, id])
  @@index([createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([action, createdAt, id])
}

model NorthTemplate {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  name           Json
  description    Json?
  status         NorthResourceStatus    @default(ACTIVE)
  currentVersion Int                    @default(1)
  createdBy      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  creator        User                   @relation("NorthTemplateCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  versions       NorthTemplateVersion[]

  @@index([status, slug])
}

model NorthTemplateVersion {
  id         String        @id @default(cuid())
  templateId String
  version    Int
  snapshot   Json
  createdBy  String
  createdAt  DateTime      @default(now())
  template   NorthTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  creator    User          @relation("NorthTemplateVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

enum TenantRole {
  OWNER
  ADMIN
  BILLING_ADMIN
  MEMBER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum InvitationKind {
  EMAIL
  CODE
}

enum NorthScope {
  PLATFORM
  ORGANIZATION
  PERSONAL
}

enum NorthResourceKind {
  SYSTEM
  CONTENT
}

enum NorthCategoryClass {
  SYSTEM
  TEMPLATE
  CUSTOM
}

enum NorthResourceStatus {
  ACTIVE
  ARCHIVED
}

enum NorthPanelVisibility {
  PRIVATE
  SHOWCASE
}

enum NorthPanelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NorthPermissionScope {
  PLATFORM
  ORGANIZATION
  CATEGORY
  SUBCATEGORY
  PANEL
}

enum NorthAudienceType {
  ALL_MEMBERS
  ROLES
  GROUPS
  PERMISSIONS
  SPECIFIC_USERS
}

enum NorthAssetStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
  QUARANTINED
}

enum NorthPanelAccessPolicyMode {
  LEGACY_AUDIENCE
  ACL_V1
}

enum NorthDatasetStatus {
  ACTIVE
  ARCHIVED
}

enum NorthDatasetFieldType {
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  TIME
}

enum NorthDatasetFieldStatus {
  ACTIVE
  DEPRECATED
}

enum NorthDatasetAclEffect {
  ALLOW
  DENY
}

enum NorthDatasetAclPrincipalType {
  ALL_MEMBERS
  MEMBERSHIP
  GROUP
  ROLE
  CAPABILITY
}

enum NorthDatasetImportStatus {
  AWAITING_UPLOAD
  SECURITY_PENDING
  SECURITY_BLOCKED
  SECURITY_APPROVED
  ANALYZING
  ANALYSIS_BLOCKED
  AWAITING_MAPPING
  READY_TO_ACTIVATE
  ACTIVATING
  SUCCEEDED
  CANCEL_REQUESTED
  CANCELLED
  REJECTED
  FAILED
}

enum NorthDatasetImportScanStatus {
  PENDING
  SCANNING
  APPROVED
  REJECTED
  QUARANTINED
  UNAVAILABLE
}

enum NorthDatasetRevisionMode {
  REPLACE_DATASET
}

model Organization {
  id                    String                      @id @default(cuid())
  name                  String
  slug                  String                      @unique
  status                OrganizationStatus          @default(ACTIVE)
  /// Explicit opt-in for anonymous, read-only showcase of panels marked SHOWCASE.
  showcaseEnabled       Boolean                     @default(false)
  description           String?
  /// Validated data URL (PNG/JPEG/WebP, <=512x512, <=256 KB); null falls back to initials.
  iconData              String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  memberships           Membership[]
  groups                OrganizationGroup[]
  invitations           Invitation[]
  subscriptions         Subscription[]
  entitlements          Entitlement[]
  billingProfile        OrganizationBillingProfile?
  homePanelId           String?
  storageLimitBytes     BigInt                      @default(10737418240)
  storageUsedBytes      BigInt                      @default(0)
  storageReservedBytes  BigInt                      @default(0)
  documentTypes         DocumentType[]
  documentClients       DocumentClient[]
  documents             Document[]
  northCategories       NorthCategory[]
  northSubcategories    NorthSubcategory[]
  northPanels           NorthPanel[]
  northRoleGrants       NorthRoleGrant[]
  northGroupGrants      NorthGroupGrant[]
  northMembershipGrants NorthMembershipGrant[]
  northAssets           NorthAsset[]
  northDatasets         NorthDataset[]
  northDatasetFields    NorthDatasetField[]
  northDatasetSchemas   NorthDatasetSchemaVersion[]
  northDatasetAclRules  NorthDatasetAcl[]
  northDatasetImports   NorthDatasetImportJob[]
  northDatasetAnalyses  NorthDatasetImportAnalysis[]
  northDatasetMappings  NorthDatasetImportMappingVersion[]
  northDatasetBatches   NorthDatasetImportBatch[]
  northDatasetRevisions NorthDatasetRevision[]
  northAnalyticsBindings NorthAnalyticsBinding[]

  @@index([status, createdAt])
}

model OrganizationBillingProfile {
  id               String        @id @default(cuid())
  organizationId   String        @unique
  status           BillingStatus @default(ACTIVE)
  currency         String        @default("USD")
  basePriceMinor   Int           @default(1400)
  memberPriceMinor Int           @default(500)
  billingEmail     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status])
}

model Membership {
  id                    String                         @id @default(cuid())
  organizationId        String
  userId                String
  role                  TenantRole                     @default(MEMBER)
  createdAt             DateTime                       @default(now())
  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  groupMemberships      OrganizationGroupMember[]
  permissionGrants      MembershipPermissionGrant[]
  northPermissionGrants NorthMembershipGrant[]
  northPanelAudiences   NorthPanelAudienceMembership[]
  northDatasetAclRules  NorthDatasetAcl[]
  northDatasetImports   NorthDatasetImportJob[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId])
}

model OrganizationGroup {
  id                    String                    @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships           OrganizationGroupMember[]
  permissionGrants      GroupPermissionGrant[]
  invitationGrants      InvitationGroupGrant[]
  northPermissionGrants NorthGroupGrant[]
  northPanelAudiences   NorthPanelAudienceGroup[]
  northDatasetAclRules  NorthDatasetAcl[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model NorthCategory {
  id                    String                   @id @default(cuid())
  organizationId        String?
  scope                 NorthScope
  resourceKind          NorthResourceKind
  categoryClass         NorthCategoryClass
  name                  Json
  description           Json?
  icon                  String?
  color                 String?
  slug                  String
  order                 Int                      @default(0)
  navigationHidden      Boolean                  @default(false)
  status                NorthResourceStatus      @default(ACTIVE)
  sourceTemplateId      String?
  sourceTemplateVersion Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  organization          Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subcategories         NorthSubcategory[]
  aliases               NorthCategorySlugAlias[]
  roleGrants            NorthRoleGrant[]
  groupGrants           NorthGroupGrant[]
  membershipGrants      NorthMembershipGrant[]

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([scope, status, order, id])
}

model NorthSubcategory {
  id               String                      @id @default(cuid())
  organizationId   String
  categoryId       String
  resourceKind     NorthResourceKind
  name             Json
  description      Json?
  icon             String?
  color            String?
  slug             String
  order            Int                         @default(0)
  navigationHidden Boolean                     @default(false)
  status           NorthResourceStatus         @default(ACTIVE)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         NorthCategory               @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  panels           NorthPanel[]
  aliases          NorthSubcategorySlugAlias[]
  roleGrants       NorthRoleGrant[]
  groupGrants      NorthGroupGrant[]
  membershipGrants NorthMembershipGrant[]

  @@unique([id, organizationId])
  @@unique([categoryId, slug])
  @@index([organizationId, categoryId, status, order, id])
}

model NorthPanel {
  id                  String                         @id @default(cuid())
  organizationId      String
  subcategoryId       String
  resourceKind        NorthResourceKind
  name                Json
  description         Json?
  icon                String?
  color               String?
  slug                String
  order               Int                            @default(0)
  navigationHidden    Boolean                        @default(false)
  status              NorthPanelStatus               @default(DRAFT)
  audienceType        NorthAudienceType              @default(ALL_MEMBERS)
  accessPolicyMode    NorthPanelAccessPolicyMode     @default(LEGACY_AUDIENCE)
  /// PRIVATE is the default. SHOWCASE additionally requires the organization opt-in and publication.
  visibility          NorthPanelVisibility           @default(PRIVATE)
  publishedRevisionId String?
  draftRevisionId     String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  organization        Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subcategory         NorthSubcategory               @relation(fields: [subcategoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  aliases             NorthPanelSlugAlias[]
  roleGrants          NorthRoleGrant[]
  groupGrants         NorthGroupGrant[]
  membershipGrants    NorthMembershipGrant[]
  audienceRoles       NorthPanelAudienceRole[]
  audienceGroups      NorthPanelAudienceGroup[]
  audiencePermissions NorthPanelAudiencePermission[]
  audienceMemberships NorthPanelAudienceMembership[]
  revisions           NorthPanelRevision[]           @relation("PanelRevisions")
  publishedRevision   NorthPanelRevision?            @relation("PublishedRevision", fields: [publishedRevisionId, id], references: [id, panelId], onDelete: Restrict)
  draftRevision       NorthPanelRevision?            @relation("DraftRevision", fields: [draftRevisionId, id], references: [id, panelId], onDelete: Restrict)
  analyticsBindings   NorthAnalyticsBinding[]

  @@unique([id, organizationId])
  @@unique([subcategoryId, slug])
  @@index([organizationId, subcategoryId, status, order, id])
}

model NorthDataset {
  id                     String                      @id @default(cuid())
  organizationId         String
  name                   Json
  description            Json?
  slug                   String
  status                 NorthDatasetStatus          @default(ACTIVE)
  currentSchemaVersionId String?
  activeRevisionId        String?
  createdBy              String
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator                User                        @relation("NorthDatasetCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  fields                 NorthDatasetField[]
  schemaVersions         NorthDatasetSchemaVersion[] @relation("NorthDatasetSchemaVersions")
  currentSchemaVersion   NorthDatasetSchemaVersion?  @relation("CurrentDatasetSchemaVersion", fields: [currentSchemaVersionId, id, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)
  aclRules               NorthDatasetAcl[]
  importJobs             NorthDatasetImportJob[]
  importAnalyses         NorthDatasetImportAnalysis[]
  importMappings         NorthDatasetImportMappingVersion[]
  importBatches          NorthDatasetImportBatch[]
  revisions              NorthDatasetRevision[]          @relation("NorthDatasetRevisions")
  activeRevision         NorthDatasetRevision?           @relation("ActiveDatasetRevision", fields: [activeRevisionId, id, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)
  analyticsBindings      NorthAnalyticsBinding[]

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId, status, createdAt, id])
}

model NorthAnalyticsBinding {
  id             String       @id @default(cuid())
  organizationId String
  panelId        String
  datasetId      String
  name           String
  query          Json
  allowedFilters Json
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  panel          NorthPanel   @relation(fields: [panelId, organizationId], references: [id, organizationId], onDelete: Restrict)
  dataset        NorthDataset @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creator        User         @relation("NorthAnalyticsBindingCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([id, panelId, organizationId])
  @@index([organizationId, panelId, createdAt, id])
  @@index([organizationId, datasetId])
}

model NorthDatasetField {
  id              String                           @id @default(cuid())
  organizationId  String
  datasetId       String
  key             String
  displayName     Json
  description     Json?
  canonicalType   NorthDatasetFieldType
  semanticType    String?
  nullable        Boolean                          @default(true)
  status          NorthDatasetFieldStatus          @default(ACTIVE)
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  organization    Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset         NorthDataset                     @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  schemaSnapshots NorthDatasetSchemaVersionField[]

  @@unique([id, datasetId, organizationId])
  @@unique([datasetId, key])
  @@index([organizationId, datasetId, status, id])
}

model NorthDatasetSchemaVersion {
  id             String                           @id @default(cuid())
  organizationId String
  datasetId      String
  version        Int
  createdBy      String
  createdAt      DateTime                         @default(now())
  organization   Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset        NorthDataset                     @relation("NorthDatasetSchemaVersions", fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creator        User                             @relation("NorthDatasetSchemaCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  fields         NorthDatasetSchemaVersionField[]
  currentFor     NorthDataset[]                   @relation("CurrentDatasetSchemaVersion")
  importBatches  NorthDatasetImportBatch[]
  revisions      NorthDatasetRevision[]

  @@unique([id, datasetId, organizationId])
  @@unique([datasetId, version])
  @@index([organizationId, datasetId, createdAt])
}

model NorthDatasetSchemaVersionField {
  organizationId  String
  datasetId       String
  schemaVersionId String
  datasetFieldId  String
  canonicalType   NorthDatasetFieldType
  semanticType    String?
  nullable        Boolean
  status          NorthDatasetFieldStatus
  ordinal         Int
  schemaVersion   NorthDatasetSchemaVersion @relation(fields: [schemaVersionId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)
  datasetField    NorthDatasetField         @relation(fields: [datasetFieldId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)

  @@id([schemaVersionId, datasetFieldId])
  @@unique([schemaVersionId, ordinal])
  @@index([organizationId, datasetId, schemaVersionId])
}

model NorthDatasetAcl {
  id             String                       @id @default(cuid())
  organizationId String
  datasetId      String
  effect         NorthDatasetAclEffect
  principalType  NorthDatasetAclPrincipalType
  membershipId   String?
  groupId        String?
  role           TenantRole?
  capability     String?
  createdBy      String
  createdAt      DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset        NorthDataset                 @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership     Membership?                  @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  group          OrganizationGroup?           @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creator        User                         @relation("NorthDatasetAclCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([id, datasetId, organizationId])
  @@index([organizationId, datasetId, effect, principalType])
  @@index([organizationId, membershipId])
  @@index([organizationId, groupId])
}

model NorthDatasetImportJob {
  id                      String                       @id @default(cuid())
  organizationId          String
  datasetId               String
  requestedBy             String
  requestedMembershipId   String
  idempotencyOperation    String
  idempotencyKey          String
  requestHash             String
  filename                String
  declaredMime            String
  declaredSize            BigInt
  declaredChecksum        String
  storageKey              String                       @unique
  storageVersionId        String?
  storageEtag             String?
  status                  NorthDatasetImportStatus     @default(AWAITING_UPLOAD)
  scanStatus              NorthDatasetImportScanStatus @default(PENDING)
  progress                Int                          @default(0)
  attempts                Int                          @default(0)
  maxAttempts             Int                          @default(3)
  availableAt             DateTime                     @default(now())
  claimedAt               DateTime?
  claimExpiresAt          DateTime?
  claimedBy               String?
  claimToken              String?
  confirmedAt             DateTime?
  securityApprovedAt      DateTime?
  cancellationRequestedAt DateTime?
  cancelledAt             DateTime?
  completedAt             DateTime?
  lastErrorCode           String?
  activationMappingId     String?
  activationRequestedBy   String?
  materializationAttempts Int                          @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset                 NorthDataset                 @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  requester               User                         @relation("NorthDatasetImportRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  requestedMembership     Membership                   @relation(fields: [requestedMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  analysis                NorthDatasetImportAnalysis?
  mappings                NorthDatasetImportMappingVersion[]
  activationMapping       NorthDatasetImportMappingVersion? @relation("SelectedImportMapping", fields: [activationMappingId, id, datasetId, organizationId], references: [id, importId, datasetId, organizationId], onDelete: Restrict)
  activationRequester     User?                        @relation("NorthDatasetActivationRequester", fields: [activationRequestedBy], references: [id], onDelete: Restrict)
  batch                   NorthDatasetImportBatch?

  @@unique([id, datasetId, organizationId])
  @@unique([organizationId, requestedMembershipId, requestedBy, idempotencyOperation, idempotencyKey])
  @@index([organizationId, datasetId, createdAt, id])
  @@index([status, availableAt, claimExpiresAt, id])
  @@index([organizationId, requestedBy, createdAt, id])
}

model NorthDatasetImportAnalysis {
  id             String                @id @default(cuid())
  organizationId String
  datasetId      String
  importId       String                @unique
  parserVersion  String
  workbook       Json
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset        NorthDataset          @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  import         NorthDatasetImportJob @relation(fields: [importId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)

  @@unique([id, importId, datasetId, organizationId])
  @@unique([importId, datasetId, organizationId])
  @@index([organizationId, datasetId, createdAt])
}

model NorthDatasetImportMappingVersion {
  id             String                @id @default(cuid())
  organizationId String
  datasetId      String
  importId       String
  version        Int
  sheetOrdinal   Int
  headerRow      Int
  definition     Json
  createdBy      String
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset        NorthDataset          @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  import         NorthDatasetImportJob @relation(fields: [importId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)
  creator        User                  @relation("NorthDatasetImportMappingCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  selectedFor    NorthDatasetImportJob[] @relation("SelectedImportMapping")
  importBatches  NorthDatasetImportBatch[]

  @@unique([importId, version])
  @@unique([id, importId, datasetId, organizationId])
  @@index([organizationId, datasetId, importId, createdAt])
}

model NorthDatasetImportBatch {
  id               String                    @id
  organizationId   String
  datasetId        String
  importId         String                    @unique
  schemaVersionId  String
  mappingVersionId String
  sheetOrdinal     Int
  rowCount         Int
  parserVersion    String
  createdAt        DateTime                  @default(now())
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset          NorthDataset              @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  import           NorthDatasetImportJob     @relation(fields: [importId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)
  mapping          NorthDatasetImportMappingVersion @relation(fields: [mappingVersionId, importId, datasetId, organizationId], references: [id, importId, datasetId, organizationId], onDelete: Restrict)
  schemaVersion    NorthDatasetSchemaVersion @relation(fields: [schemaVersionId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)
  rows             NorthDatasetRow[]
  revisions        NorthDatasetRevisionBatch[]

  @@unique([id, datasetId, organizationId])
  @@unique([importId, datasetId, organizationId])
  @@index([organizationId, datasetId, createdAt])
  @@index([schemaVersionId])
}

