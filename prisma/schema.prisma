  organizationId String
  datasetId      String
  batchId        String
  ordinal        Int
  values         Json
  createdAt      DateTime                @default(now())
  batch          NorthDatasetImportBatch @relation(fields: [batchId, datasetId, organizationId], references: [id, datasetId, organizationId], onDelete: Restrict)

  @@unique([batchId, ordinal])
  @@index([organizationId, datasetId, batchId, ordinal])
}

model NorthDatasetRevision {
  id              String                    @id
  organizationId  String
  datasetId       String
  schemaVersionId String
  version         Int
  mode            NorthDatasetRevisionMode
  rowCount        Int
  createdBy       String
  createdAt       DateTime                  @default(now())
