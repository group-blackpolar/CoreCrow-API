# CORECROW — sample configuration, never real credentials.
DATABASE_URL="postgresql://corecrow:replace-me@127.0.0.1:5432/corecrow?connection_limit=10&connect_timeout=5&socket_timeout=10"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:4000"
# Production must include https://blackpolar.org and https://north.blackpolar.org.
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3100"
PORT=4000
NODE_ENV=development
# SMTP is required for signup verification/recovery. CoreCrow verifies the
# connection during readiness checks but never sends a message from health.
# Google Workspace relay example (authorize the VPS IP and require TLS in Admin):
# SMTP_URL="smtp://smtp-relay.gmail.com:587?requireTLS=true"
# Use the public FQDN whose DNS resolves to the sending VPS, not a Docker hostname.
# SMTP_HELO_NAME="api.blackpolar.org"
# Authenticated SMTP example (percent-encode the username/password):
# SMTP_URL="smtps://contact%40blackpolar.org:APP_PASSWORD@smtp.gmail.com:465"
SMTP_URL="smtp://127.0.0.1:1025"
SMTP_HELO_NAME=""
MAIL_FROM="Black Polar <identity@blackpolar.org>"
# Public NORTH origin used to build organization invitation links.
NORTH_PUBLIC_URL="http://localhost:3000"
NORTH_EMBED_ALLOWED_DOMAINS="youtube.com,youtu.be,vimeo.com,lookerstudio.google.com"
# TASK 8E object storage. Credentials are resolved by the AWS SDK credential
# chain on the backend host and are never returned to NORTH.
NORTH_ASSET_S3_BUCKET=""
NORTH_ASSET_S3_REGION=""
NORTH_ASSET_S3_ENDPOINT=""
NORTH_ASSET_S3_FORCE_PATH_STYLE=false
NORTH_ASSET_UPLOAD_URL_TTL_SECONDS=300
NORTH_ASSET_READ_URL_TTL_SECONDS=300
NORTH_ASSET_DEFAULT_STORAGE_LIMIT_BYTES=10737418240
NORTH_ASSET_IMAGE_MAX_BYTES=10485760
NORTH_ASSET_DOCUMENT_MAX_BYTES=52428800
NORTH_ASSET_VIDEO_MAX_BYTES=262144000
# Shared private clamd endpoint for ordinary NORTH assets, user avatars and
# dataset imports. Configure either the socket or host/port, never both.
CORECROW_CLAMAV_SOCKET=""
CORECROW_CLAMAV_HOST="corecrow-clamav"
CORECROW_CLAMAV_PORT=3310
CORECROW_CLAMAV_TIMEOUT_MS=30000
# Wall-clock cap for one scan, however slowly bytes keep flowing.
CORECROW_CLAMAV_DEADLINE_MS=600000
CORECROW_CLAMAV_MAX_BYTES=262144000
CORECROW_CLAMAV_CHUNK_BYTES=65536
# Tenant dataset XLSX imports use a separately scoped, private and versioned S3
# bucket. The worker refuses to start when bucket versioning is unavailable.
# AWS credentials come from the SDK credential chain on the trusted host; never
# put them in this file in source control.
NORTH_DATA_IMPORT_S3_BUCKET=""
NORTH_DATA_IMPORT_S3_REGION=""
NORTH_DATA_IMPORT_S3_ENDPOINT=""
NORTH_DATA_IMPORT_S3_FORCE_PATH_STYLE=false
NORTH_DATA_IMPORT_UPLOAD_TTL_SECONDS=900
NORTH_DATA_IMPORT_MAX_BYTES=52428800
# Legacy NORTH_DATA_IMPORT_CLAMAV_* endpoint variables remain accepted during
# migration, but new hosts should use the shared CORECROW_CLAMAV_* settings.
# Keep this false until the private versioned bucket and ClamAV probe pass.
NORTH_DATA_IMPORT_WORKER_ENABLED=false
# Docker network shared by API, worker, MinIO and ClamAV. The release script
# defaults to corecrow-api_default when it is omitted and validates the value.
CORECROW_DOCKER_NETWORK="corecrow-api_default"
NORTH_DATA_IMPORT_WORKER_POLL_MS=1000
NORTH_DATA_IMPORT_WORKER_LEASE_MS=60000
NORTH_DATA_IMPORT_WORKER_HEARTBEAT_MS=15000
NORTH_DATA_IMPORT_WORKER_RETRY_DELAY_MS=60000
NORTH_CATEGORY_LIMIT=100
NORTH_SUBCATEGORY_LIMIT=100
NORTH_PANEL_LIMIT=100
NORTH_SECTION_LIMIT=50
NORTH_COMPONENT_LIMIT=100
# Durable internal notifications for public contact requests.
CONTACT_NOTIFICATIONS_ENABLED=false
CONTACT_NOTIFICATION_TO="contact@blackpolar.org"
# Optional Google OAuth. Register the v1 callback at the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="http://localhost:4000/v1/auth/oauth/google/callback"
# Use loopback or the exact immediate proxy IP (Docker bridge gateway for a loopback-published container).
TRUST_PROXY=""
# Used by docker-compose only.
POSTGRES_PASSWORD="replace-me"

# CoreCrow AI is disabled by default and provider credentials stay server-side.
AI_ENABLED=false
AI_PROVIDER="gemini"
# gemini-2.5-flash is closed to new API users; gemini-3.8-flash is Google's replacement.
AI_DEFAULT_MODEL="gemini-3.8-flash"
# Optional reasoning effort for Gemini 3 models: minimal | low | medium | high.
AI_THINKING_LEVEL="low"
GEMINI_API_KEY=""
AI_GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
AI_PROVIDER_TIMEOUT_MS=45000
AI_RUN_TIMEOUT_MS=90000
AI_MAX_TOOL_ROUNDS=4
AI_MAX_OUTPUT_TOKENS=2048
AI_CONTEXT_MAX_MESSAGES=50
AI_CONTEXT_MAX_CHARACTERS=64000
AI_MESSAGE_MAX_CHARACTERS=8000
AI_USER_CONCURRENT_RUNS=1
AI_ORGANIZATION_CONCURRENT_RUNS=3
AI_USER_RUNS_PER_MINUTE=6
AI_ORGANIZATION_RUNS_PER_MINUTE=30
AI_ACTION_TTL_SECONDS=600
# Version and micro-USD cost per one million tokens; zero means tracking without an estimate.
AI_PRICING_VERSION="unpriced-v1"
AI_INPUT_USD_MICROS_PER_MILLION_TOKENS=0
AI_OUTPUT_USD_MICROS_PER_MILLION_TOKENS=0
# Opt-in only: enables the real-provider smoke test when GEMINI_API_KEY is configured.
AI_REAL_GEMINI_SMOKE=false

# Documents (forms/quotes/orders): outbound WhatsApp through Meta's official WhatsApp Business Cloud API.
# Leave unset until the business account is verified; the API then reports WHATSAPP_NOT_CONFIGURED
# and NORTH shows the channel as pending instead of pretending to send. Email uses SMTP_URL/MAIL_FROM.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved template for business-initiated messages outside the 24 h window (optional but usually required).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es

# 32 random bytes (hex or base64) for recoverable AUIDs: `openssl rand -hex 32`. Server-only; never commit a real value.
# Without it, Regenerate still works but the AUID cannot be revealed.
AUID_ENCRYPTION_KEY=""
