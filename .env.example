# CORECROW — sample configuration, never real credentials.
DATABASE_URL="postgresql://corecrow:replace-me@127.0.0.1:5432/corecrow?connection_limit=10&connect_timeout=5&socket_timeout=10"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:4000"
# Production must include https://blackpolar.org and https://north.blackpolar.org.
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3100"
PORT=4000
NODE_ENV=development
# SMTP is required for signup verification/recovery. CoreCrow verifies the
# connection during readiness checks but never sends a message from health.
# Google Workspace relay example (authorize the VPS IP and require TLS in Admin):
# SMTP_URL="smtp://smtp-relay.gmail.com:587?requireTLS=true"
# Use the public FQDN whose DNS resolves to the sending VPS, not a Docker hostname.
# SMTP_HELO_NAME="api.blackpolar.org"
# Authenticated SMTP example (percent-encode the username/password):
# SMTP_URL="smtps://contact%40blackpolar.org:APP_PASSWORD@smtp.gmail.com:465"
SMTP_URL="smtp://127.0.0.1:1025"
SMTP_HELO_NAME=""
MAIL_FROM="Black Polar <identity@blackpolar.org>"
# Public NORTH origin used to build organization invitation links.
NORTH_PUBLIC_URL="http://localhost:3000"
NORTH_EMBED_ALLOWED_DOMAINS="youtube.com,youtu.be,vimeo.com,lookerstudio.google.com"
# TASK 8E object storage. Credentials are resolved by the AWS SDK credential
# chain on the backend host and are never returned to NORTH.
NORTH_ASSET_S3_BUCKET=""
NORTH_ASSET_S3_REGION=""
NORTH_ASSET_S3_ENDPOINT=""
NORTH_ASSET_S3_FORCE_PATH_STYLE=false
NORTH_ASSET_UPLOAD_URL_TTL_SECONDS=300
NORTH_ASSET_READ_URL_TTL_SECONDS=300
NORTH_ASSET_DEFAULT_STORAGE_LIMIT_BYTES=10737418240
NORTH_ASSET_IMAGE_MAX_BYTES=10485760
NORTH_ASSET_DOCUMENT_MAX_BYTES=52428800
NORTH_ASSET_VIDEO_MAX_BYTES=262144000
NORTH_CATEGORY_LIMIT=100
NORTH_SUBCATEGORY_LIMIT=100
NORTH_PANEL_LIMIT=100
NORTH_SECTION_LIMIT=50
NORTH_COMPONENT_LIMIT=100
# Durable internal notifications for public contact requests.
CONTACT_NOTIFICATIONS_ENABLED=false
CONTACT_NOTIFICATION_TO="contact@blackpolar.org"
# Optional Google OAuth. Register the v1 callback at the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="http://localhost:4000/v1/auth/oauth/google/callback"
# Use loopback or the exact immediate proxy IP (Docker bridge gateway for a loopback-published container).
TRUST_PROXY=""
# Used by docker-compose only.
POSTGRES_PASSWORD="replace-me"
