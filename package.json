{
  "name": "blackpolar-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:dataset-import-worker": "tsx watch src/dataset-import-worker.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "start:dataset-import-worker": "node dist/dataset-import-worker.js",
    "lint": "eslint src",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:watch": "tsx --test --test-concurrency=1 --watch tests/*.test.ts",
    "test:unit": "tsx --test tests/policy.test.ts tests/clamav.test.ts tests/object-storage.test.ts tests/ai.test.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed:tenant-demo": "tsx src/seed-tenant-demo.ts",
    "validate:tenant-demo": "tsx src/seed-tenant-demo.ts --validate-only",
    "provision:documents": "tsx src/provision-documents.ts",
    "validate:documents": "tsx src/provision-documents.ts --validate-only",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:integration": "tsx --test tests/integration.test.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@google/genai": "^1.29.0",
    "@prisma/client": "^6.1.0",
    "better-auth": "^1.1.0",
    "fastify": "^5.2.0",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
    "prisma": "^6.1.0",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/smtp-server": "^3.5.13",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.39.5",
    "smtp-server": "^3.19.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "yazl": "3.3.1"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
